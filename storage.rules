rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'xyronbhaiii@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.size < 2 * 1024 * 1024 * 1024
        && (request.resource.contentType.matches('video/.*') || request.resource.contentType == 'application/octet-stream');
    }

    match /posters/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'xyronbhaiii@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'xyronbhaiii@gmail.com'
        && request.auth.token.email_verified == true
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
